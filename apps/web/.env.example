# All optional — the app runs fully in demo mode with none of these set
# (mock payments, seeded demo admin accounts). See ECOMMERCE_SYSTEM.md and
# ADMIN_DASHBOARD.md.

# Enables the real Stripe payment provider (server-side).
STRIPE_SECRET_KEY=
# Required to verify real Stripe webhooks (Stripe Dashboard > Webhooks > Signing secret).
STRIPE_WEBHOOK_SECRET=
# Enables the real Stripe.js Elements UI (client-side, must start with pk_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Admin login (see ADMIN_DASHBOARD.md "Demo Accounts") — four demo accounts
# are seeded on first run, one per role, all with password
# "wellness-admin-demo". No env var needed to change this in the demo; in
# production, replace lib/server/db.ts's seedAdminUsers() with real
# account provisioning.

# Canonical site URL, used for metadata/OpenGraph tags, robots.txt and
# sitemap.xml. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=
