# All optional — the app runs fully in demo mode with none of these set
# (mock payments, default admin passcode). See ECOMMERCE_SYSTEM.md.

# Enables the real Stripe payment provider (server-side).
STRIPE_SECRET_KEY=
# Required to verify real Stripe webhooks (Stripe Dashboard > Webhooks > Signing secret).
STRIPE_WEBHOOK_SECRET=
# Enables the real Stripe.js Elements UI (client-side, must start with pk_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Overrides the default admin passcode ("wellness-admin-demo").
ADMIN_PASSCODE=
